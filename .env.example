# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
# 会話用モデル（v1.3.2で新設。こちらが優先される）
# Pilot期間中は snapshot 固定を推奨（モデル側の更新で挙動が変わると
# prompt_version ごとの比較が成立しなくなるため）
OPENAI_CONVERSATION_MODEL=gpt-4o
# 旧変数。OPENAI_CONVERSATION_MODEL 未設定時のフォールバックとして参照される
OPENAI_MODEL=
# 構造化抽出用モデル（未設定なら gpt-4o）
# 1セッションに1回だけの呼び出しなので、会話用より上位のモデルを既定にしている
OPENAI_EXTRACTION_MODEL=gpt-4o

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# サーバー側専用。RLSを無視するキーなので NEXT_PUBLIC_ を絶対に付けないこと。
# Supabase Dashboard > Project Settings > API > service_role から取得
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Admin ----------
# /admin のログインパスワード
ADMIN_PASSWORD=
# Cookie署名とIPハッシュのソルトに使うランダム文字列
# 生成例: openssl rand -hex 32
ADMIN_SESSION_SECRET=
